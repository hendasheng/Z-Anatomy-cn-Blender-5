+class ZANATOMY_OT_show_system(bpy.types.Operator):
+    """按编号显示该系统的全部层级内容（递归），而不是只显示第一层"""
+    bl_idname = "zanatomy.show_system"
+    bl_label = "隐藏其他集合"
+    bl_options = {'REGISTER', 'UNDO'}
+
+    index: bpy.props.IntProperty(name="Index", default=1, min=0, max=99)
+    extend: bpy.props.BoolProperty(name="Extend", default=False)
+
+    @staticmethod
+    def _number_of(collection):
+        match = re.match(r"\s*(\d+)\s*[:：]", collection.name)
+        return int(match.group(1)) if match else None
+
+    @staticmethod
+    def _set_branch(lc, hide):
+        lc.hide_viewport = hide
+        if not hide:
+            lc.exclude = False
+            # 集合下的物体自身也可能被 hide_set / hide_viewport 藏起来了，
+            # 只放开集合层级会变成「只显示第一层」，所以逐层清掉物体级隐藏。
+            for ob in lc.collection.objects:
+                try:
+                    ob.hide_viewport = False
+                except Exception:
+                    pass
+                try:
+                    if ob.hide_get():
+                        ob.hide_set(False)
+                except Exception:
+                    pass
+        for child in lc.children:
+            ZANATOMY_OT_show_system._set_branch(child, hide)
+
+    def execute(self, context):
+        root = context.view_layer.layer_collection
+        targets = [lc for lc in root.children if self._number_of(lc.collection) == self.index]
+        if not targets:
+            children = list(root.children)
+            if 1 <= self.index <= len(children):
+                targets = [children[self.index - 1]]
+        if not targets:
+            self.report({'WARNING'}, "没有编号为 {:d} 的集合".format(self.index))
+            return {'CANCELLED'}
+
+        if not self.extend:
+            for lc in root.children:
+                if lc not in targets:
+                    self._set_branch(lc, True)
+        for lc in targets:
+            self._set_branch(lc, False)
+
+        context.view_layer.update()
+
+        # 让大纲视图把该集合整棵树展开（不是只展开第一层）
+        area = next((a for a in context.screen.areas if a.type == 'OUTLINER'), None)
+        if area is not None:
+            try:
+                with context.temp_override(area=area):
+                    bpy.ops.outliner.show_hierarchy()
+                    for _ in range(16):
+                        bpy.ops.outliner.expanded_toggle()
+            except Exception:
+                pass
+            area.tag_redraw()
+
+        self.report({'INFO'}, "显示：{:s}".format(", ".join(lc.collection.name for lc in targets)))
+        return {'FINISHED'}
+
 
