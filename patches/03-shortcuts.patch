+def _zanatomy_bind_system_keys():
+    # ZANATOMY-PATCH: 每次启动重绑 Outliner 的 1-0（含 alt/shift 变体），
+    # 因为 keymap 存在 userpref 里，可能被别的 Blender 实例用旧偏好覆盖。
+    try:
+        kc = bpy.context.window_manager.keyconfigs.active
+    except Exception:
+        return
+    keys = ["ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT", "NINE", "ZERO"]
+    variants = ((False, False), (False, True), (True, False), (True, True))
+    for km in kc.keymaps:
+        if km.name != "Outliner":
+            continue
+        for kmi in [i for i in km.keymap_items
+                    if i.type in keys and i.idname in ("zanatomy.show_system", "object.hide_collection")]:
+            km.keymap_items.remove(kmi)
+        for number, key in enumerate(keys, start=1):
+            for shift, alt in variants:
+                try:
+                    item = km.keymap_items.new("zanatomy.show_system", key, "PRESS",
+                                               any=False, shift=shift, ctrl=False, alt=alt,
+                                               oskey=False, key_modifier="NONE")
+                    item.properties.index = number
+                    item.properties.extend = bool(shift)
+                except Exception:
+                    pass
+
