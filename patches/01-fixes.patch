+def _zanatomy_base_names(name):
+    # fix: muscle origin/insertion objects carry suffixes like '.e', '.o', '.e1',
+    # so the text block named after the data-block could never be found.
+    names = [name]
+    base = name
+    for suffix in (".e", ".o"):
+        if base.endswith(suffix):
+            base = base[:-2]
+            break
+    match = re.match(r"^(.*)\.[eo]\d+$", name)
+    if match:
+        base = match.group(1)
+    if base != name:
+        names.append(base)
+    return names
+
