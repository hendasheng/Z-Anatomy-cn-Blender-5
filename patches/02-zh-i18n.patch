+def _cjk_font_id():
+    # ZANATOMY-PATCH: the HUD needs a CJK-capable blf font, and Blender 5.x
+    # dropped the dpi argument of blf.size() (it raised TypeError every redraw).
+    if font_info.get("cjk_tried"):
+        return font_info.get("cjk_id") or 0
+    font_info["cjk_tried"] = True
+    candidates = [
+        os.path.join(os.environ.get("LOCALAPPDATA", ""), "Microsoft", "Windows", "Fonts",
+                     "SourceHanSansCN-Regular.otf"),
+        os.path.join(os.path.expanduser("~"), "Downloads", "SourceHanSansCN-Regular.otf"),
+        os.path.join(os.environ.get("WINDIR", "C:\\Windows"), "Fonts", "SourceHanSansCN-Regular.otf"),
+        os.path.join(os.environ.get("WINDIR", "C:\\Windows"), "Fonts", "NotoSansSC-VF.ttf"),
+    ]
+    for path in candidates:
+        try:
+            if path and os.path.exists(path):
+                font_info["cjk_id"] = blf.load(path)
+                break
+        except Exception:
+            continue
+    return font_info.get("cjk_id") or 0
+
 
