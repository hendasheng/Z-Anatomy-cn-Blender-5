+def _set_panel_labels(context):
+    """面板标题是静态 RNA，切换语言时需要重新注册才会更新。"""
+    zh = _ui_lang(context) == "中文"
+    pairs = (
+        (ZANATOMY_PT_languages, "Languages"),
+        (ZANATOMY_PT_labels, "Labels"),
+        (ZANATOMY_PT_Xsection, "Cross section"),
+        (ZANATOMY_PT_Key_Color, "Key colors"),
+        (ZANATOMY_PT_Visibility, "Visibility"),
+    )
+    for panel, en in pairs:
+        want = UI_ZH.get(en, en) if zh else en
+        if panel.bl_label == want:
+            continue
+        try:
+            bpy.utils.unregister_class(panel)
+            panel.bl_label = want
+            bpy.utils.register_class(panel)
+        except Exception:
+            pass
