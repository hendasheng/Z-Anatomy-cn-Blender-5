+def _zanatomy_english_to_chinese(eng):
+    # ZANATOMY-PATCH: 从 Translations 表取英文->中文，带长度失效的简单缓存。
+    txt = bpy.data.texts.get("Translations")
+    if txt is None:
+        return None
+    raw = txt.as_string()
+    if _ZH_TEXT_CACHE["key"] != len(raw):
+        header = raw.split("\n", 1)[0].split(";")
+        mapping = {}
+        if "中文" in header:
+            idx = header.index("中文")
+            for line in raw.splitlines()[1:]:
+                cells = line.split(";")
+                if len(cells) > idx and cells[idx].strip():
+                    mapping[cells[0]] = cells[idx].strip()
+        _ZH_TEXT_CACHE["map"] = mapping
+        _ZH_TEXT_CACHE["key"] = len(raw)
+    return _ZH_TEXT_CACHE["map"].get(eng)
+
