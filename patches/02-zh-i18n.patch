+def _ui_lang(context):
+    """UI 语言：优先用插件里选的语言，未选时跟随 Blender 界面语言。"""
+    lang = ""
+    try:
+        lang = context.scene.zanatomy.ui_language
+    except Exception:
+        lang = ""
+    if lang:
+        return lang
+    try:
+        if bpy.context.preferences.view.language.startswith("zh"):
+            return "中文"
+    except Exception:
+        pass
+    return "English"
+
+
+def _t(context, msgid):
+    if _ui_lang(context) == "中文":
+        return UI_ZH.get(msgid, msgid)
+    return msgid
+
