+def _zanatomy_apply_language(context, lang):
+    # ZANATOMY-PATCH: 语言下拉一改就应用；同时切换 UI 文案与说明文本。
+    try:
+        context.scene.zanatomy.ui_language = "中文" if lang == "中文" else "English"
+    except Exception:
+        pass
+    try:
+        _set_panel_labels(context)
+    except Exception:
+        pass
+    outcome = None
+    try:
+        outcome = bpy.ops.object.translate_atlas(lang=lang)
+    except Exception as ex:
+        print("Z-Anatomy: 应用语言失败:", ex)
+    try:
+        _zanatomy_sync_editor_text()
+    except Exception:
+        pass
+    return outcome
+
